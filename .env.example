# Copie este arquivo para .env.local e preencha com os dados do SEU projeto Supabase
# (painel > Project Settings > API). O arquivo .env.local nunca deve ser versionado.

# URL do projeto, ex.: https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública ("anon" ou "publishable"). Pode ir para o navegador: quem protege os dados é o RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ATENÇÃO: NÃO crie variável com a chave "service_role" neste projeto.
# Ela ignora o RLS e jamais deve ir para o navegador, para o código ou para o repositório.

# Aviso no Discord (opcional). URL do webhook do canal de trocas. É um SEGREDO: quem tem a URL posta no canal.
# Sem ela o site funciona normal, só não posta no Discord.
DISCORD_WEBHOOK_URL= https://discord.com/api/webhooks/1564143379434971186/s2RPKrx8Ib7dqKBpnxu5rtWM9BA-y51xyg3OuTe19RUgBkVOlxc9_ibMNnEpXZLFyK8e
